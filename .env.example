# Copiar a .env y rellenar. No commitear .env.
POSTGRES_USER=askbox
POSTGRES_PASSWORD=
POSTGRES_DB=askbox
DATABASE_URL=postgresql://askbox:CAMBIAR@db:5432/askbox
REDIS_URL=redis://redis:6379/0

# Master key AES-256-GCM (32 bytes). Generar con: openssl rand -hex 32
# Si se pierde, las claves de proveedor guardadas no se pueden descifrar.
ASKBOX_MASTER_KEY=

# Claves de SISTEMA opcionales (solo servidor; un proyecto las usa solo si allow_system_keys=true)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Auth / límites (valores por defecto entre paréntesis)
ASKBOX_COOKIE_SECURE=false      # true detrás de HTTPS
ASKBOX_ALLOW_REGISTER=false     # false: solo el primer usuario puede registrarse
ASKBOX_ASK_RATE_PER_MIN=30

# Recuperación de contraseña (/forgot -> /reset)
ASKBOX_PUBLIC_URL=http://localhost:8067   # base de los enlaces de reset (URL pública de la web)
ASKBOX_RESET_TTL_MINUTES=30
ASKBOX_LOG_RESET_LINK=true      # sin SMTP: el enlace de reset se escribe en los logs de la API (docker compose logs api)
ASKBOX_DEV_SHOW_RESET_TOKEN=false  # SOLO desarrollo local: devuelve reset_url en la respuesta de /forgot. Nunca true en producción
# SMTP opcional (si ASKBOX_SMTP_HOST y ASKBOX_SMTP_FROM están definidos se envía el email)
ASKBOX_SMTP_HOST=
ASKBOX_SMTP_PORT=587
ASKBOX_SMTP_USER=
ASKBOX_SMTP_PASSWORD=
ASKBOX_SMTP_FROM=
ASKBOX_SMTP_TLS=starttls        # starttls | ssl | none

# Opcional (cloudflared)
CLOUDFLARE_TUNNEL_TOKEN=
