# Copiar a .env y rellenar. No commitear .env.
POSTGRES_USER=askbox
POSTGRES_PASSWORD=
POSTGRES_DB=askbox
DATABASE_URL=postgresql://askbox:CAMBIAR@db:5432/askbox
REDIS_URL=redis://redis:6379/0

# Master key AES-256-GCM (32 bytes). Generar con: openssl rand -hex 32
# Si se pierde, las claves de proveedor guardadas no se pueden descifrar.
ASKBOX_MASTER_KEY=

# Claves de SISTEMA opcionales (solo servidor; un proyecto las usa solo si allow_system_keys=true)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Auth / límites (valores por defecto entre paréntesis)
ASKBOX_COOKIE_SECURE=false      # true detrás de HTTPS
ASKBOX_ALLOW_REGISTER=false     # false: solo el primer usuario puede registrarse
ASKBOX_ASK_RATE_PER_MIN=30

# Recuperación de contraseña (/forgot -> /reset)
ASKBOX_PUBLIC_URL=http://localhost:8067   # base de los enlaces de reset (URL pública de la web)
ASKBOX_RESET_TTL_MINUTES=30
# Con SMTP activo (ASKBOX_SMTP_HOST + ASKBOX_SMTP_FROM): los resets van por email.
# Sin SMTP: ASKBOX_LOG_RESET_LINK=true escribe el enlace en los logs (docker compose logs api | grep RESET_LINK)
ASKBOX_LOG_RESET_LINK=true
ASKBOX_DEV_SHOW_RESET_TOKEN=false  # SOLO desarrollo local: devuelve reset_url en la respuesta de /forgot. Nunca true en producción

# Brevo SMTP — https://app.brevo.com → SMTP & API → clave SMTP (no la contraseña de la cuenta)
# Remitente (ASKBOX_SMTP_FROM) debe estar verificado en Brevo (Senders & IP).
ASKBOX_SMTP_HOST=smtp-relay.brevo.com
ASKBOX_SMTP_PORT=587
ASKBOX_SMTP_USER=tu-email-de-login@ejemplo.com
ASKBOX_SMTP_PASSWORD=xsmtpsib-REEMPLAZAR
ASKBOX_SMTP_FROM=noreply@tudominio-verificado.com
ASKBOX_SMTP_TLS=starttls

# Opcional (cloudflared)
CLOUDFLARE_TUNNEL_TOKEN=

# /settings/git: repo hermano montado en la API (kit de orquestación). Rutas del host.
# ASKBOX_KIT_PATH=../cursor-agent-orchestrator
# ASKBOX_EXTRA_REPOS=cursor-agent-orchestrator=/repos/cursor-agent-orchestrator
