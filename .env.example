# Copiar a .env y rellenar. No commitear .env.
POSTGRES_USER=askbox
POSTGRES_PASSWORD=
POSTGRES_DB=askbox
DATABASE_URL=postgresql://askbox:CAMBIAR@db:5432/askbox
REDIS_URL=redis://redis:6379/0

# Master key AES-256-GCM (32 bytes). Generar con: openssl rand -hex 32
# Si se pierde, las claves de proveedor guardadas no se pueden descifrar.
ASKBOX_MASTER_KEY=

# Claves de SISTEMA opcionales (solo servidor; un proyecto las usa solo si allow_system_keys=true)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# POST /v1/route (perfil fijo para el 7B local; lo llama sanitize).
# Bearer ab_live_… (scope ask:read) no necesita ASKBOX_TOKEN en el servidor.
# ASKBOX_TOKEN solo si sanitize envía un secreto compartido que no es ab_live_….
# ASKBOX_ROUTE_PROJECT_ID: uuid del proyecto con clave Gemini (este endpoint no llama a OpenRouter).
# ASKBOX_ROUTE_TIMEOUT_MS queda por debajo del timeout ~800 ms de sanitize (tope interno 780).
# Este endpoint solo llama a Gemini (tier fast del catálogo). OpenRouter no participa.
ASKBOX_TOKEN=
ASKBOX_ROUTE_PROJECT_ID=
ASKBOX_ROUTE_TIMEOUT_MS=650
ASKBOX_ROUTE_RATE_PER_MIN=120

# Ollama local (servicio Compose `ollama`, imagen ollama/ollama, volumen ollama_data).
# provider=ollama (o model=ollama/<slug>) es 100 % local: no llama a Gemini, OpenRouter ni a la web.
# Sin modelo, o con model=auto: código → OLLAMA_MODEL/ALLIN_CODE_MODEL; razonamiento duro →
# OLLAMA_REASON_MODEL; texto/NLP → OLLAMA_NLP_MODEL; contexto largo → OLLAMA_LONGCTX_MODEL.
# Esos slots solo se usan si el proyecto los tiene activos (GET/PUT /v1/projects/{id}/ollama-models
# o la sección «Modelos locales» en /projects). Por defecto solo el de código está activo:
# un slot inactivo cae al principal activo (Qwen) y, si no queda ninguno, a la cascada de nube.
# OLLAMA_DEFAULT_ACTIVE_MODELS vacío = solo código. "*" = los cuatro. O una lista de slugs.
# mode=allin (o provider=allin) es el híbrido: puede usar la nube. El informe final usa ALLIN_NLP_MODEL.
# Sin provider=ollama ni mode/provider=allin, Gemini/OpenRouter no cambian.
# OLLAMA_BASE_URL es el DNS interno (red askbox_default). El puerto publicado es solo 127.0.0.1:11434.
# Llama 3.3 en Ollama es solo 70B: no existe llama3.3:8b. El texto/NLP usa llama3.1:8b.
# Descarga (un pull por tag): docker exec ollama ollama pull qwen2.5-coder:14b
#   y lo mismo con deepseek-r1:14b, llama3.1:8b y mistral-nemo:12b.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_REASON_MODEL=deepseek-r1:14b
OLLAMA_NLP_MODEL=llama3.1:8b
OLLAMA_LONGCTX_MODEL=mistral-nemo:12b
ALLIN_CODE_MODEL=qwen2.5-coder:14b
ALLIN_REASON_MODEL=deepseek-r1:14b
ALLIN_NLP_MODEL=llama3.1:8b
ALLIN_LONGCTX_MODEL=mistral-nemo:12b
OLLAMA_TIMEOUT=120
# Vacío: solo qwen2.5-coder:14b (slot de código) activo por proyecto hasta que la UI/API lo cambie.
OLLAMA_DEFAULT_ACTIVE_MODELS=
# Proceso del contenedor ollama (no los lee la API):
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Auth / límites (valores por defecto entre paréntesis)
ASKBOX_COOKIE_SECURE=false      # true detrás de HTTPS (p. ej. askbox.softportweb.com)
ASKBOX_ALLOW_REGISTER=false     # false: solo el primer usuario puede registrarse
ASKBOX_ASK_RATE_PER_MIN=30

# Recuperación de contraseña (/forgot -> /reset)
ASKBOX_PUBLIC_URL=http://localhost:8067   # producción: https://askbox.softportweb.com
# Prefijo público de la API (Next reescribe /api/* → contenedor api). Vacío solo si usas :8066 sin proxy.
ASKBOX_API_EXTERNAL_PREFIX=/api
ASKBOX_RESET_TTL_MINUTES=30
# Con SMTP activo (ASKBOX_SMTP_HOST + ASKBOX_SMTP_FROM): los resets van por email.
# ASKBOX_LOG_RESET_LINK=true: sin SMTP o si falla el envío, el enlace va a logs (grep RESET_LINK)
ASKBOX_LOG_RESET_LINK=true
ASKBOX_DEV_SHOW_RESET_TOKEN=false  # SOLO desarrollo local: devuelve reset_url en la respuesta de /forgot. Nunca true en producción

# Brevo SMTP — https://app.brevo.com → SMTP & API → clave SMTP (no la contraseña de la cuenta)
# Remitente (ASKBOX_SMTP_FROM) debe estar verificado en Brevo (Senders & IP).
ASKBOX_SMTP_HOST=smtp-relay.brevo.com
ASKBOX_SMTP_PORT=587
ASKBOX_SMTP_USER=tu-email-de-login@ejemplo.com
ASKBOX_SMTP_PASSWORD=xsmtpsib-REEMPLAZAR
ASKBOX_SMTP_FROM=noreply@tudominio-verificado.com
ASKBOX_SMTP_TLS=starttls

# Cloudflare Tunnel (OPCIONAL). Sin esto, askbox funciona en localhost/LAN (puertos 8066/8067).
# Solo si usas túnel: Zero Trust → Tunnels → tu tunnel → Install connector → pega el token aquí.
# Arranque: docker compose --profile tunnel up -d  (el servicio cloudflared no sube sin ese profile).
# Public hostname en CF: tu-dominio → http://web:3000 (Next proxea /api/* a la API).
# También puedes guardar el token cifrado en /settings/deploy (BD); igualmente hay que copiarlo aquí para cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=

# Auto-update diario (worker): git pull --ff-only + docker compose up -d --build en este repo.
# Requiere montar el repo y docker.sock en el servicio worker (ver docker-compose.yml).
ASKBOX_AUTO_UPDATE=true
ASKBOX_AUTO_UPDATE_HOUR=5
ASKBOX_AUTO_UPDATE_MINUTE=0

# /settings/git: repo hermano montado en la API (kit de orquestación). Rutas del host.
# ASKBOX_KIT_PATH=../cursor-agent-orchestrator
# ASKBOX_EXTRA_REPOS=cursor-agent-orchestrator=/repos/cursor-agent-orchestrator
