# Copiar a openclaw/.env y rellenar. No commitear openclaw/.env.
# Lo lee `docker compose -f openclaw/docker-compose.yml` (directorio de proyecto = openclaw/).
# Ningún valor de aquí es un secreto real.

# --- askbox (red Docker askbox_default; el contenedor se llama api) ---
# Token de proyecto ab_live_… (scope ask:read) o el secreto de servicio ASKBOX_TOKEN de askbox.
# Vacío: el proxy responde 503 en /v1/chat/completions.
ASKBOX_TOKEN=
ASKBOX_MODE=allin
# ASKBOX_UPSTREAM y OLLAMA_UPSTREAM los fija el compose (http://api:8000 y http://ollama:11434).
# UPSTREAM_TIMEOUT=300

# --- lean trim (destino local / allin / ollama) ---
LEAN_KEEP_MESSAGES=4
LEAN_OLLAMA_MODEL=qwen2.5-coder:14b
LEAN_MAX_OUTPUT_TOKENS=128
LEAN_STRIP_ENVELOPE=1
LEAN_DEBUG=0
# System estable (prefijo de caché KV). Vacío en el compose usa el default de app.py.
LEAN_SYSTEM=Eres un asistente en OpenClaw. Quien escribe es el usuario; nunca digas que tú eres él ni copies su nombre como propio. Responde en su idioma, breve y directo. Si piden un formato, cúmplelo exacto. No inventes datos.

# --- SPLIT: último user con código → modelo local; chat → cloud-fast ---
# 0 desactiva el split (se respeta el model que mande OpenClaw, tras quitar askbox/|ollama/).
# No reescribe deepseek-chat, deepseek-reasoner, deepseek/<id> ni provider=deepseek
# (API nativa en askBox). deepseek-r1:14b sigue siendo el tag local de Ollama.
# La clave DEEPSEEK_API_KEY vive en el .env de askbox, no aquí.
SPLIT_ENABLED=1
CHAT_CLOUD_MODEL=cloud-fast
# 1 = llamar también a /v1/route en turnos de chat (cloud). Por defecto el chat no se enruta.
ROUTE_ON_CHAT=0

# --- cliente POST /v1/route (perfiles lean|standard|full) ---
# 0: no llama a askbox; el recorte es el de lean v2 (LEAN_*).
# 1: pide perfil a ASKBOX_UPSTREAM/v1/route y clampa la respuesta a PROFILES en app.py.
ROUTE_ENABLED=1
ROUTE_URL=http://api:8000/v1/route
ROUTE_TIMEOUT_MS=800
ROUTE_FALLBACK=standard
ROUTE_FASTPATH_CHARS=200
# Opcionales (no están en el compose; app.py tiene default):
# ROUTE_LAST_USER_CHARS=1500
# ROUTE_FULL_SYSTEM_CHARS=2400
# ROUTE_SUMMARY_SYSTEM_CHARS=700
# ROUTE_STANDARD_PROMPT_CHARS=3200
# ROUTE_FULL_PROMPT_CHARS=9000
# LEAN_SYSTEM_CHARS=500
# LEAN_PROMPT_CHARS=1800
# ASKBOX_MAX_OUTPUT_TOKENS=512

# --- gateway OpenClaw (solo si levantas openclaw-gateway; sanitize no lo usa) ---
# openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_TZ=Europe/Madrid
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# OPENCLAW_MEM_LIMIT=2560m
# OPENCLAW_CPUS=2
# Rutas de host del vps4; cámbialas si no existen.
# OPENCLAW_PROJECTS_HOST=/var/www/proyectos_web
# OPENCLAW_SSH_KEYS_HOST=/root/.ssh/keys_remote

# Solo con `docker compose --profile tunnel up` (túnel dedicado). Si clawbox va
# en el cloudflared de askbox, déjalo vacío y no actives el profile.
CLOUDFLARE_TUNNEL_TOKEN=
